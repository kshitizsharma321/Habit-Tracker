# Server port (Render sets this automatically in production)
PORT=3000

# MongoDB connection string
# Local:
MONGODB_URI=mongodb://localhost:27017/habit-tracker
# Atlas (production):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/habit-tracker?retryWrites=true&w=majority

# Frontend URL for CORS (set to your Vercel URL in production, leave empty for local dev)
FRONTEND_URL=

# VAPID keys for Web Push notifications
# Generate once with: npx web-push generate-vapid-keys
# Then copy the same public key into frontend/.env as VITE_VAPID_PUBLIC_KEY
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# JWT secret for authentication tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Google OAuth Client ID (for Google Sign-In)
# Get from https://console.cloud.google.com/apis/credentials
# Then add the same ID to frontend/.env as VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=
