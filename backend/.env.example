# ─────────────────────────────────────────────────────────────────────────────
# Habit Tracker — Backend environment variables
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# Tags: [REQUIRED] = server won't run without it · [OPTIONAL] = enables a feature
# ─────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Port the server listens on. Defaults to 3000. (Render sets this for you.)
PORT=3000

# [REQUIRED] MongoDB connection string.
#   Local:  mongodb://localhost:27017/habit-tracker
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/habit-tracker?retryWrites=true&w=majority
MONGODB_URI=

# [REQUIRED] Secret used to sign JWT auth tokens — use a long random string, keep it private.
#   Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# [REQUIRED IN PRODUCTION] Frontend origin — drives BOTH the CORS allowlist and the
#   links inside password-reset emails. The server REFUSES TO START when NODE_ENV=production
#   and this is unset, because the old localhost fallback silently broke both.
#   Local dev: leave empty (falls back to http://localhost:5173 and :4173).
#   Production: https://your-app.vercel.app   (no trailing slash needed — it's stripped)
#   Multiple origins: comma-separate them for Vercel preview deploys. The FIRST is
#   canonical (used in emails); the rest only widen CORS. e.g.
#   FRONTEND_URL=https://habit.vercel.app,https://habit-git-dev-you.vercel.app
FRONTEND_URL=

# [OPTIONAL] Set to "production" on your host so config guards + error hiding activate.
#   Render sets this automatically; set it manually only if your host doesn't.
NODE_ENV=

# [OPTIONAL] Web Push (VAPID) keys — enable browser push reminders. Set BOTH or neither.
#   Generate once: npx web-push generate-vapid-keys
#   The public key must also be set in the frontend as VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# [OPTIONAL] Google Sign-In. The same client ID must be set in the frontend as VITE_GOOGLE_CLIENT_ID.
#   Get one at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# [OPTIONAL] Supabase Storage — enables nightly CSV backups. Set BOTH or neither.
#   First create a PRIVATE bucket named "habit-backups" in Supabase → Storage.
#   SUPABASE_URL              Project URL (Supabase → Settings → API), e.g. https://<project>.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY The SECRET service-role key. Server-side ONLY — never expose to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# [OPTIONAL] AI "Coach's note" insights — powered by Google Gemini. Omit to disable (app works fine without).
#   Get a free API key at https://aistudio.google.com/apikey
#   GEMINI_MODEL defaults to gemini-2.5-flash if unset.
GEMINI_API_KEY=
GEMINI_MODEL=

# [OPTIONAL] Password-reset emails — sent through Gmail's own SMTP (nodemailer).
#   Why Gmail SMTP and not an ESP: Resend/Brevo/SendGrid all reject a @gmail.com
#   sender on free plans (they require a domain you own). Sending via Gmail makes
#   Google the real sender — no domain, free, and excellent inbox placement.
#   Setup on the sending Gmail account:
#     1. Turn on 2-Step Verification → myaccount.google.com/security
#     2. Create an App Password    → myaccount.google.com/apppasswords
#     3. Paste the 16-char App Password below (spaces are fine, they're stripped)
#   Set BOTH or the feature no-ops ("Forgot password?" stays silent; admin reset
#   still works). GMAIL_FROM_NAME is optional (defaults to "Habit Tracker").
#   Free Gmail sends up to 500 emails/day. Reset links use FRONTEND_URL (set above).
#   ⚠️ Real credentials go ONLY in .env (gitignored) — never in this committed template.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=
